#!/usr/bin/env bash
#
# Auto-bump the patch version on every commit, mirror it into manifest.json,
# and stage both so the bump is part of the commit being created.
#
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
"$ROOT/scripts/bump-version.sh"

# The build never rewrites an existing manifest.json, so keep its Version in step here
# (cheaper than running ./gradlew updatePluginManifest on every commit).
VERSION="$(awk -F'=' '/^version[[:space:]]*=/ {gsub(/[[:space:]]/, "", $2); print $2; exit}' "$ROOT/gradle.properties")"
MANIFEST="$ROOT/src/main/resources/manifest.json"
sed -i.bak -E "s/^([[:space:]]*\"Version\":[[:space:]]*\")[^\"]*\"/\1${VERSION}\"/" "$MANIFEST"
rm -f "$MANIFEST.bak"

git add "$ROOT/gradle.properties" "$MANIFEST"
